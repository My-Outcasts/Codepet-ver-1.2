# Firebase web config (public client identifiers — safe to expose; access is
# enforced by Firestore security rules). Copy these into .env.local and fill in
# the values from Firebase console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Anthropic API key for byte's live task loop (Phase 3). SERVER-SIDE ONLY —
# do not prefix with NEXT_PUBLIC. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opt in to byte's maintained-decisions memory: on approval, extract durable
# decisions (Sonnet 5) into companies/{uid}.decisions. Off unless set to "true".
# Adds ~1 cheap model call per approval; tracked under the `memory` usage key.
# AI_MEMORY_ENABLED=true

# Optional override for the per-user daily generation cap (default 30).
# AI_DAILY_LIMIT=30

# Firebase Admin (server-side). The /api/run-task route verifies the caller's
# Firebase ID token. Verification works with just the project id above — these
# are OPTIONAL, only needed for privileged Admin ops (custom tokens, checkRevoked).
# From Firebase console → Project settings → Service accounts → Generate new key.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Sentry error tracking (Phase 4). Optional — the app no-ops without it. The DSN
# is safe to expose (NEXT_PUBLIC). Create a project at https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=

# Second Brain rebuild (P0/P1). When "1", the Second Brain / Overview map renders the
# derived knowledge graph (real deliverables, decisions, milestones from the event
# ledger) instead of the static company→department→task tree. Unset/0 = today's view.
NEXT_PUBLIC_SECOND_BRAIN_V2=0

# Second Brain recall (P2). Server flag — with a Voyage key, byte can answer questions over
# the event ledger via semantic search ("Ask your Second Brain"). Inert unless BOTH are set.
SECOND_BRAIN_RECALL=0
# VOYAGE_API_KEY=

# GitHub App ("Codepet Builder") — powers the GitHub-backed cloud build (connect a repo,
# byte opens a branch + PR instead of writing to sandbox-only storage). SERVER-SIDE ONLY.
# Register the App first — see "Registering the Codepet Builder GitHub App" in
# docs/e2b-template.md — then fill these in from the App's settings page.
GITHUB_APP_ID=
# PEM contents from the App's "Generate a private key" button. Paste either as a single
# line with literal \n escapes in place of real newlines, or as-is with real newlines —
# both forms are supported.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App's URL slug (from its public page, github.com/apps/<slug>) — used to build the
# install URL users are sent to when connecting a repo.
GITHUB_APP_SLUG=codepet-builder
# HMAC secret signing the OAuth/install `state` param on the connect flow. Required — the
# app throws on startup of that flow if this is unset. Generate with e.g. `openssl rand -hex 32`.
GITHUB_STATE_SECRET=

# Client flag enabling the repo-cloud build path (connect a real GitHub repo instead of
# the sandbox-only demo build). Off by default until the GitHub App above is registered
# and configured.
# NEXT_PUBLIC_CLOUD_REPO_BUILD=1
